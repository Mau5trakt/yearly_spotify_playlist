# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Spotify Developer Dashboard (https://developer.spotify.com/dashboard) ---
# Client ID and Client Secret of your app.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# --- Refresh token ---
# You obtained it with: python -m yearly_spotify_playlist.auth
SPOTIFY_REFRESH_TOKEN=your_refresh_token

# --- Optional ---
# Redirect URI registered in the dashboard. It must match exactly.
# Spotify does not accept "localhost": only a literal loopback IP.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ISO 3166-1 alpha-2 market used to filter out unavailable content (e.g. ES).
# If left empty, your account's country is used.
SPOTIFY_MARKET=